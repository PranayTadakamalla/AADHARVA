// Function to initialize the map with more detailed rural project points
export const initMap = (mapElement: HTMLElement): void => {
  // Always use enhanced mock map for more reliable demonstration
  createMockMap(mapElement);
};

// Enhanced mock map with detailed project data visualization
function createMockMap(mapElement: HTMLElement): void {
  // Clear any existing content
  mapElement.innerHTML = '';
  
  // Configure the map container
  mapElement.style.position = "relative";
  mapElement.style.backgroundColor = "#070b14"; // Dark background
  mapElement.style.overflow = "hidden";
  
  // Add sci-fi map background (India outline)
  const mapBackground = document.createElement("div");
  mapBackground.style.position = "absolute";
  mapBackground.style.inset = "0";
  mapBackground.style.backgroundImage = "url('https://images.unsplash.com/photo-1580891080041-8c13a4e5e7b8?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTB8fGluZGlhJTIwbWFwfGVufDB8fDB8fHww&auto=format&fit=crop&w=900&q=60')";
  mapBackground.style.backgroundSize = "cover";
  mapBackground.style.backgroundPosition = "center";
  mapBackground.style.opacity = "0.3";
  mapElement.appendChild(mapBackground);
  
  // Add glowing grid overlay
  const gridOverlay = document.createElement("div");
  gridOverlay.style.position = "absolute";
  gridOverlay.style.inset = "0";
  gridOverlay.style.backgroundImage = "linear-gradient(rgba(10, 255, 255, 0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(10, 255, 255, 0.1) 1px, transparent 1px)";
  gridOverlay.style.backgroundSize = "50px 50px";
  gridOverlay.style.pointerEvents = "none";
  mapElement.appendChild(gridOverlay);
  
  // Add a radial gradient in the center
  const radialOverlay = document.createElement("div");
  radialOverlay.style.position = "absolute";
  radialOverlay.style.inset = "0";
  radialOverlay.style.background = "radial-gradient(circle at center, rgba(10, 255, 255, 0.1) 0%, transparent 70%)";
  radialOverlay.style.pointerEvents = "none";
  mapElement.appendChild(radialOverlay);
  
  // Add detailed project points with our real project data
  const detailedProjects = [
    // Water projects (cyan)
    { x: 27, y: 25, color: "#0affff", title: "Smart Water Monitoring System", type: "water", status: "Active", progress: 75, budget: "₹450,000", beneficiaries: "12,850" },
    { x: 32, y: 32, color: "#0affff", title: "Community Rainwater Harvesting", type: "water", status: "Active", progress: 60, budget: "₹320,000", beneficiaries: "8,500" },
    
    // Agriculture projects (green)
    { x: 68, y: 55, color: "#10b981", title: "Precision Farming Initiative", type: "agriculture", status: "Active", progress: 80, budget: "₹680,000", beneficiaries: "1,560" },
    { x: 38, y: 60, color: "#10b981", title: "IoT Crop Monitoring", type: "agriculture", status: "Planning", progress: 25, budget: "₹540,000", beneficiaries: "3,200" },
    
    // Education projects (purple)
    { x: 55, y: 78, color: "#7c3aed", title: "Rural Digital Classroom", type: "education", status: "Active", progress: 90, budget: "₹290,000", beneficiaries: "5,400" },
    { x: 75, y: 68, color: "#7c3aed", title: "Mobile Learning Lab", type: "education", status: "Active", progress: 85, budget: "₹345,000", beneficiaries: "8,900" },
    
    // Healthcare projects (cyan)
    { x: 60, y: 42, color: "#0affff", title: "Telemedicine Center", type: "healthcare", status: "Active", progress: 95, budget: "₹780,000", beneficiaries: "34,500" },
    { x: 20, y: 25, color: "#0affff", title: "Mobile Diagnostic Unit", type: "healthcare", status: "Active", progress: 70, budget: "₹520,000", beneficiaries: "22,400" },
    
    // Energy projects (green)
    { x: 72, y: 88, color: "#10b981", title: "Solar Microgrid", type: "energy", status: "Active", progress: 85, budget: "₹890,000", beneficiaries: "6,800" },
    { x: 45, y: 45, color: "#10b981", title: "Community Biogas Plant", type: "energy", status: "Planning", progress: 30, budget: "₹430,000", beneficiaries: "4,200" },
    
    // Connectivity projects (purple)
    { x: 15, y: 15, color: "#7c3aed", title: "Rural Mesh Network", type: "connectivity", status: "Active", progress: 65, budget: "₹620,000", beneficiaries: "15,600" },
    { x: 80, y: 50, color: "#7c3aed", title: "Satellite Internet Hub", type: "connectivity", status: "Planning", progress: 40, budget: "₹740,000", beneficiaries: "18,200" },
    
    // Governance projects (blue)
    { x: 65, y: 30, color: "#2563eb", title: "Community Decision Platform", type: "governance", status: "Active", progress: 75, budget: "₹380,000", beneficiaries: "42,000" },
    { x: 50, y: 85, color: "#2563eb", title: "Rural E-Governance Center", type: "governance", status: "Active", progress: 80, budget: "₹420,000", beneficiaries: "28,500" }
  ];
  
  // Add each project point with enhanced interactive tooltip
  detailedProjects.forEach(project => {
    addEnhancedMapPoint(mapElement, project);
  });
  
  // Add region labels
  addRegionLabel(mapElement, 25, 20, "Northern Region");
  addRegionLabel(mapElement, 60, 85, "Southern Region");
  addRegionLabel(mapElement, 75, 45, "Eastern Region");
  addRegionLabel(mapElement, 40, 50, "Western Region");
  
  // Add map title overlay
  const titleOverlay = document.createElement("div");
  titleOverlay.style.position = "absolute";
  titleOverlay.style.top = "10px";
  titleOverlay.style.left = "10px";
  titleOverlay.style.padding = "5px 10px";
  titleOverlay.style.backgroundColor = "rgba(0, 0, 0, 0.7)";
  titleOverlay.style.borderRadius = "4px";
  titleOverlay.style.color = "#0affff";
  titleOverlay.style.fontSize = "14px";
  titleOverlay.style.fontWeight = "bold";
  titleOverlay.style.textShadow = "0 0 5px #0affff";
  titleOverlay.textContent = "AADHARVA Rural Development Map";
  mapElement.appendChild(titleOverlay);
  
  // Add interactive legend
  const legend = document.createElement("div");
  legend.style.position = "absolute";
  legend.style.bottom = "10px";
  legend.style.right = "10px";
  legend.style.backgroundColor = "rgba(0, 0, 0, 0.8)";
  legend.style.borderRadius = "4px";
  legend.style.padding = "10px";
  legend.style.color = "white";
  legend.style.fontSize = "12px";
  legend.style.maxWidth = "200px";
  
  const legendTitle = document.createElement("div");
  legendTitle.style.fontWeight = "bold";
  legendTitle.style.marginBottom = "5px";
  legendTitle.style.color = "#0affff";
  legendTitle.textContent = "Project Types";
  legend.appendChild(legendTitle);
  
  const legendItems = [
    { color: "#0affff", label: "Water & Healthcare" },
    { color: "#10b981", label: "Agriculture & Energy" },
    { color: "#7c3aed", label: "Education & Connectivity" },
    { color: "#2563eb", label: "Governance" }
  ];
  
  legendItems.forEach(item => {
    const legendItem = document.createElement("div");
    legendItem.style.display = "flex";
    legendItem.style.alignItems = "center";
    legendItem.style.marginTop = "5px";
    
    const legendColor = document.createElement("div");
    legendColor.style.width = "12px";
    legendColor.style.height = "12px";
    legendColor.style.borderRadius = "50%";
    legendColor.style.backgroundColor = item.color;
    legendColor.style.marginRight = "5px";
    legendColor.style.boxShadow = `0 0 5px ${item.color}`;
    
    const legendLabel = document.createElement("div");
    legendLabel.textContent = item.label;
    
    legendItem.appendChild(legendColor);
    legendItem.appendChild(legendLabel);
    legend.appendChild(legendItem);
  });
  
  mapElement.appendChild(legend);
  
  // Add interactive controls
  const controls = document.createElement("div");
  controls.style.position = "absolute";
  controls.style.top = "10px";
  controls.style.right = "10px";
  controls.style.display = "flex";
  controls.style.gap = "5px";
  
  // Zoom in button
  const zoomInBtn = createMapButton("+");
  zoomInBtn.addEventListener("click", () => {
    // Simulate zoom in effect
    gridOverlay.style.backgroundSize = "70px 70px";
  });
  controls.appendChild(zoomInBtn);
  
  // Zoom out button
  const zoomOutBtn = createMapButton("-");
  zoomOutBtn.addEventListener("click", () => {
    // Simulate zoom out effect
    gridOverlay.style.backgroundSize = "30px 30px";
  });
  controls.appendChild(zoomOutBtn);
  
  // Reset view button
  const resetBtn = createMapButton("⟲");
  resetBtn.addEventListener("click", () => {
    // Reset to default view
    gridOverlay.style.backgroundSize = "50px 50px";
  });
  controls.appendChild(resetBtn);
  
  mapElement.appendChild(controls);
}

function addMapPoint(mapElement: HTMLElement, x: number, y: number, color: string, title: string): void {
  const point = document.createElement("div");
  point.style.position = "absolute";
  point.style.left = `${x}%`;
  point.style.top = `${y}%`;
  point.style.width = "12px";
  point.style.height = "12px";
  point.style.borderRadius = "50%";
  point.style.backgroundColor = color;
  point.style.boxShadow = `0 0 10px ${color}, 0 0 20px ${color}`;
  point.style.transform = "translate(-50%, -50%)";
  point.style.animation = "pulse 2s infinite";
  point.title = title;
  
  // Add tooltip capabilities
  point.addEventListener("mouseenter", function() {
    const tooltip = document.createElement("div");
    tooltip.className = "map-tooltip";
    tooltip.style.position = "absolute";
    tooltip.style.left = `calc(${x}% + 10px)`;
    tooltip.style.top = `${y}%`;
    tooltip.style.backgroundColor = "rgba(15, 23, 42, 0.9)";
    tooltip.style.color = "#fff";
    tooltip.style.padding = "5px 10px";
    tooltip.style.borderRadius = "4px";
    tooltip.style.fontSize = "12px";
    tooltip.style.zIndex = "100";
    tooltip.style.whiteSpace = "nowrap";
    tooltip.textContent = title;
    mapElement.appendChild(tooltip);
    point.dataset.tooltip = "active";
  });
  
  point.addEventListener("mouseleave", function() {
    const tooltip = mapElement.querySelector(".map-tooltip");
    if (tooltip) {
      mapElement.removeChild(tooltip);
    }
    delete point.dataset.tooltip;
  });
  
  mapElement.appendChild(point);
}

